# ==== AKUN LOGIN (wajib diisi di Vercel -> Settings -> Environment Variables) ====
APP_USERNAME=admin
APP_PASSWORD=ganti-password-ini
# Rahasia untuk tanda tangan sesi. Isi acak saja, contoh: hasil `openssl rand -hex 32`
AUTH_SECRET=

# ==== AI ROUTER KAMU ====
# API key router kamu. Kalau KOSONG, aplikasi jalan di MODE DEMO (data contoh).
AI_ROUTER_API_KEY=
# Base URL router (OpenAI-compatible). Contoh: https://routerkamu.com/v1
AI_ROUTER_BASE_URL=https://api.openai.com/v1
# Header tambahan opsional (JSON), contoh: {"X-Custom":"1"}
AI_ROUTER_EXTRA_HEADERS=
